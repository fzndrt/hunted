# =====================================================================
# WAJIB DIISI DI VERCEL (Settings -> Environment Variables) ATAU .env
# =====================================================================
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Opsional: isi jika ingin alert JALUR 2 (Veteran Swing) masuk ke grup/channel Telegram terpisah.
# Jika dikosongkan, alert Jalur 2 tetap masuk ke TELEGRAM_CHAT_ID dengan header berbeda: [JALUR 2 · VETERAN SWING].
TELEGRAM_SWING_CHAT_ID=""

# Password acak panjang untuk mengamankan endpoint /api/scan (Cron) & /api/webhook (Telegram)
CRON_SECRET=""
TELEGRAM_WEBHOOK_SECRET=""

# =====================================================================
# SANGAT DISARANKAN UNTUK VERCEL (Gratis di upstash.com / Vercel Marketplace)
# Menjaga daftar posisi Exit Guard & cooldown alert TIDAK HILANG saat cold start
# =====================================================================
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# =====================================================================
# OPSIONAL (API Key & Kalibrasi Filter Anti-Pucuk)
# =====================================================================
JUPITER_API_KEY=""
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# Khusus VPS (otomatis memakai /tmp/corridor_desk.db jika berjalan di Vercel tanpa Upstash)
DB_PATH="./data/corridor_desk.db"

# Jadwal Pemindaian & Exit Guard (khusus mode VPS main.py)
SCAN_INTERVAL_SEC="45"
EXIT_CHECK_INTERVAL_SEC="20"
ALERT_COOLDOWN_MIN="30"

# Kalibrasi v4: Viral Velocity, Pullback OHLCV, Smart Viral Pareto & Daily Consolidation
REACTION_DELAY_SEC="22"
MIN_SCORE="76"
MAX_ROUND_TRIP_LOSS_PCT="4.5"
MAX_DEPTH_CLIFF_LOSS_PCT="13.5"
MIN_NET_HEADROOM_PCT="18.0"
MAX_M5_CHANGE_PCT="22.0"
MAX_FRESH_H1_CHANGE_PCT="115.0"
MAX_H1_CHANGE_PCT="210.0"
MIN_PAIR_AGE_MINUTES="20"
MIN_LIQUIDITY_USD="12000"
MIN_VOL_M5_USD="8000"
MIN_VOL_H1_USD="55000"
MIN_TURNOVER_H1_RATIO="0.60"
MIN_VOL_M5_ACCEL_RATIO="0.55"
INCLUDE_MIDCAP_CORRIDOR="true"

# PumpPortal Real-Time Stream (khusus mode VPS)
ENABLE_PUMPPORTAL_STREAM="false"
PUMPPORTAL_MIN_SOL_TRADE="3.0"
SOL_PRICE_FALLBACK_USD="160.0"
